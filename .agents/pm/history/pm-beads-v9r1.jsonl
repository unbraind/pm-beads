es diff. Restore only that generated change, then run the pinned pm health --strict-exit --require-merge-drivers with an empty home and no global Git configuration."},{"op":"add","path":"/metadata/expected_result","value":"The installer and strict health agree with the repository-owned extension merge policy without unrelated tracked changes."},{"op":"add","path":"/metadata/actual_result","value":"The installer replaces -merge with merge=text; restoring the repository policy yields merge_fence_drift:2 in isolated strict health."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"7d120006c37b4fe5f21d02d2386b4a2190e801b9cf342fa8796bd629fffef413","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"27879ac7a3f4fe13c2161e1a0d77edea4bd343a07f0f77a47c510c8354249f5b"}
