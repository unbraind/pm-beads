{"ts":"2026-08-30T17:56:51.972Z","author":"claude","author_source":"asserted","agent_harness":"claude-code","agent_instance":"f6f0eca1ec68ebcb847cfaf3","agent_provenance":{"model":null,"effort":{"value":"xhigh","source":"environment"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-beads-vb7j"},{"op":"add","path":"/metadata/title","value":"Move the host CLI pin and its version-contract constant together so the bump can land"},{"op":"add","path":"/metadata/description","value":"A packaging test asserts the @unbrained/pm-cli devDependency equals REQUIRED_DEVELOPMENT_VERSION, a constant declared in the test file, with the stated rationale that a gate verdict depends on which CLI version runs it. Dependabot edits package.json and never touches test files, so its bump breaks the equality and the pull request fails the coverage gate, which is why the open bump has been blocked. Moving both to 2026.8.30 adopts the release that fixes the npm 12 package install breakage. Verified under the newly pinned binary that pm health reports no history drift, which matters because the pinned binary is what validates tracked item history in CI."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-08-30T17:56:51.972Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-08-30T17:56:51.972Z"},{"op":"add","path":"/metadata/author","value":"claude"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"03ed4bfc3bdaf13231baad81fd7f077cc667d126fa0068bbbbeee00b0cb3d645","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"failed","reason":"resolver_failed","resolver":"claude_session_file","rule_version":"v1"},"version":