completed_at: "2026-09-17T20:12:42.848Z"
claim_principal: pi-agent
author: pi-agent
acceptance_criteria: "package.json pins @unbrained/pm-cli 2026.9.17 exactly, test/packaging.test.ts REQUIRED_DEVELOPMENT_VERSION equals 2026.9.17, the lockfile resolves pm-cli 2026.9.17 and pm-ops 2026.9.13 and pm-changelog 2026.9.16, and npm run release:check exits 0 on the new pins"
resolution: "Advanced @unbrained/pm-cli from 2026.9.12 to 2026.9.17, pm-ops from 2026.9.11 to 2026.9.13, and pm-changelog from 2026.9.13 to 2026.9.16. Updated REQUIRED_DEVELOPMENT_VERSION in test/packaging.test.ts from 2026.9.12 to 2026.9.17."
expected_result: "release:check exits 0 on @unbrained/pm-cli 2026.9.17"
actual_result: "release:check exited 0 on 2026.9.17: 351 of 351 tests pass, coverage gate met, changelog:check up to date, verify:release-publish-attestation ok, verify:release-changelog-date ok"
