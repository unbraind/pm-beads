  - command: python3 .agents/pm/verify-release-yaml.py
    path: .github/workflows/release.yml
    scope: project
    note: "release.yml parses; alert job has if: failure(), needs release, issues:write; ci gate installs drivers before health and passes --require-merge-drivers"
  - command: "grep -q -- --require-merge-drivers .github/workflows/ci.yml && grep -q \"merge=pm-item-toon\" .gitattributes && ./node_modules/.bin/pm merge install >/dev/null 2>&1 && git config --local --get-regexp ^merge\\\\.pm | grep -q merge.pm-item-toon"
    path: .
    scope: project
    note: ci gate requires merge drivers; .gitattributes declares them; install provisions clone-local config
  - command: "npm run build:test && node --test test/alert-on-release-failure.test.ts"
    path: test/alert-on-release-failure.test.ts
